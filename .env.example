# Kotan configuration — copy to .env and fill in. .env is gitignored;
# never commit real values.

# ---------- required ----------
BOT_MAIN_TOKEN=          # Discord bot token (Developer Portal → Bot)
CLIENT_ID=               # OAuth app client id (dashboard login)
CLIENT_SECRET=           # OAuth app client secret
SESSION_SECRET=          # >=32 random chars — signs OAuth state (e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`)

# ---------- bot ----------
PREFIX=.                 # message-command prefix
OWNER_IDS=               # comma-separated Discord user ids — bot-level owners
DEVELOPER_IDS=           # comma-separated ids — dashboard /admin access

# ---------- dashboard ----------
SITE_URL=http://localhost:3000   # public base URL; drives OAuth redirect + cookie security
# OAUTH_REDIRECT_URI=            # override only for unusual setups (default SITE_URL/auth/callback)
WEB_HOST=local           # local | public/lan | specific interface IP
# WEB_PORT=3000          # local port override (SERVER_PORT/PORT also work)
# COOKIE_SECURE=true     # session cookie gets Secure flag. AUTO-ON when SITE_URL
                         # is https — set 'false' only if you really mean it.
# TRUST_PROXY=loopback   # who may set X-Forwarded-For. loopback (default) |
                         # false | hop count | "ip,ip/cidr" list.
                         # 'true' lets ANY client spoof their IP and bypass
                         # per-IP rate limits — don't use it.
# DISCORD_DOMAIN_HASH=   # Developer Portal domain-verification token

# ---------- storage ----------
# SQLite backend (default): data/kotan.sqlite, values AES-256-GCM encrypted.
# DB_KEY=                # 64-hex key OR passphrase for value encryption.
                         # Unset → generated once into data/.dbkey (mode 600).
                         # Back it up — losing it makes the DB unreadable.
# REDIS_URL=redis://…    # use Redis instead of SQLite (values still encrypted;
                         # the guild blacklist table is SQLite-only though).

# ---------- developer REST API (optional, localhost only) ----------
# DEV_API_KEY=           # bearer token >=16 chars — unset = API off entirely
# DEV_API_PORT=3210
# DEV_API_HOST=127.0.0.1 # DON'T expose non-loopback — it's an ops surface
# DEV_API_EVAL=          # '1' adds POST /eval = arbitrary code execution.
                         # Only honored on loopback binds; devctl sets it for
                         # supervised local sessions.

# ---------- extras ----------
# LASTFM_API_KEY=        # powers the .fm command family — create one at
                         # https://www.last.fm/api/account/create (free)
# SENTRY_DSN=            # error reporting (needs `npm i @sentry/node`)
# OPENROUTER_API_KEY=    # scripts/openrouter.js
# OPENROUTER_MODEL=      # override the default model
